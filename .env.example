# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# DATA_DIR=data
# MAX_PDF_SIZE_MB=25
# LOG_LEVEL=INFO
# RERANK_ENABLED=true
# MAX_HISTORY_CHARS=6000

# Reproducibility Agent (backend/repro_check_agent.py, backend/repo_fetch.py)
# Optional: raises the GitHub API rate limit from 60/hr (unauthenticated) to
# 5000/hr. A fine-grained PAT with no scopes (public-repo read access) is enough --
# create one at https://github.com/settings/tokens
# GITHUB_TOKEN=
# REPRO_HTTP_TIMEOUT_SECONDS=15
# REPRO_MAX_FILE_BYTES=200000
# REPRO_MAX_TREE_ENTRIES=3000
# REPRO_MAX_TREE_ENTRIES_IN_PROMPT=150
# REPRO_LLM_CLAIMS_ENABLED=true

# Codegen Agent -- runs when no repo is linked/found (generates an implementation
# attempt from the paper, then evaluates it with the same checks as a real repo)
# CODEGEN_ENABLED=true
# CODEGEN_MAX_INPUT_CHARS=20000
# CODEGEN_EXTRACT_MAX_TOKENS=1500
# CODEGEN_GENERATE_MAX_TOKENS=4000

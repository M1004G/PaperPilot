# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# DATA_DIR=data
# MAX_PDF_SIZE_MB=25
# LOG_LEVEL=INFO
# RERANK_ENABLED=true
# MAX_HISTORY_CHARS=6000

# LLM call behaviour
# LLM_MAX_RETRIES=5
# LLM_BACKOFF_BASE_SECONDS=1.0
# LLM_MAX_CONCURRENT_CALLS=3
# LLM_TIMEOUT_SECONDS=60

# Frontend: where the Streamlit app finds the API
# BACKEND_URL=http://localhost:8000

# Discovery agent (standalone, not wired into the API yet)
# SEMANTIC_SCHOLAR_API_KEY=
# DISCOVERY_HTTP_TIMEOUT_SECONDS=15
# DISCOVERY_SEARCH_POOL_SIZE=20
# DISCOVERY_FILTER_MAX_TOKENS=500
# DISCOVERY_MAX_RESULTS=5
# DISCOVERY_PDF_MAX_SIZE_MB=25
